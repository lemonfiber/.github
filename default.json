{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":pinAllExceptPeerDependencies",
    "helpers:pinGitHubActionDigests",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/Amsterdam",
  "commitBody": "Spec: GOV-R12\n\nSigned-off-by: Wessel Verheij <info@nightworks.io>",
  "prBodyNotes": [
    "Routine dependency update — cites `Spec: GOV-R12`, so it passes spec-check automatically."
  ],
  "labels": ["dependencies"],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security"],
    "minimumReleaseAge": null
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "docker-compose": {
    "managerFilePatterns": [
      "/(^|/)(?:docker-)?compose[^/]*\\.ya?ml$/",
      "/^compose/.+\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "actions/setup-python pins written inline in workflows",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["python-version:\\s*\"?(?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?)\"?"],
      "depNameTemplate": "python",
      "datasourceTemplate": "python-version",
      "versioningTemplate": "python"
    },
    {
      "customType": "regex",
      "description": "actions/setup-node pins written inline in workflows",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["node-version:\\s*\"?(?<currentValue>\\d+(?:\\.\\d+){0,2})\"?"],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "node"
    },
    {
      "customType": "regex",
      "description": "gitleaks CLI version downloaded by the shared security workflow",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "ver=\"(?<currentValue>[\\d.]+)\"",
        "gitleaks/gitleaks/releases/download/v(?<currentValue>[\\d.]+)/"
      ],
      "depNameTemplate": "gitleaks/gitleaks",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "osv-scanner CLI version downloaded by the shared security workflow",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["osv-scanner/releases/download/v(?<currentValue>[\\d.]+)/"],
      "depNameTemplate": "google/osv-scanner",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Routine churn travels together; a major never rides along with it.",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "non-major dependencies"
    },
    {
      "description": "A major is a judgement call, so it arrives on its own and says so.",
      "matchUpdateTypes": ["major"],
      "addLabels": ["major-update"],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "The shared gates live in spec; their pins move as one so no repo runs a stale gate.",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["lemonfiber/spec"],
      "groupName": "shared workflows from spec",
      "schedule": ["at any time"]
    },
    {
      "description": "The runtime a repo builds on is a deliberate choice, not routine churn.",
      "matchDepNames": ["node", "python"],
      "groupName": null,
      "addLabels": ["toolchain"]
    }
  ]
}
