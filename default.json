{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", ":pinAllExceptPeerDependencies", "helpers:pinGitHubActionDigests"],
  "commitBody": "Spec: GOV-R12\n\nSigned-off-by: Wessel Verheij <info@nightworks.io>",
  "prBodyNotes": [
    "Routine dependency update — cites `Spec: GOV-R12`, so it passes spec-check automatically."
  ],
  "labels": ["dependencies"],
  "packageRules": [
    { "matchUpdateTypes": ["minor", "patch", "digest"], "groupName": "non-major dependencies" }
  ]
}
